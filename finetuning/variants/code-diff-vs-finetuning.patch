+"""D-194 variant checks, synthetic and CPU only (no private data, no download): V1 focal loss and V2 six context turns.
+
+    python -m unittest test_variants        (run from this folder)
+"""
+import copy
+import json
+import math
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import labels as L  # noqa: E402
+import model_inputs as MI  # noqa: E402
+import test_training as TT  # noqa: E402  (tiny_config, tiny_backbone, encode, example, labels, IDENTITY)
+
+try:
+    import torch
+    import multihead as M
+    import train_multihead as TM
+    HAVE_TORCH = True
+except ImportError:
+    HAVE_TORCH = False
+
+STUDENT, TOPIC, AIDEL, AIRESP = L.AXES
+FOCAL_NAMES = {"single_select": "focal_cross_entropy", "multi_select": "focal_bce_with_logits_mean_over_codes"}
+
+
+def logits_for(seed):
+    g = torch.Generator().manual_seed(seed)
+    return {a: 2 * torch.randn(len(L.DIRECT_CODES[a]), generator=g) for a in L.AXES}
+
+
+def weights_for(seed):
+    g = torch.Generator().manual_seed(seed)
+    return {a: [float(x) for x in 0.5 + 2 * torch.rand(len(L.DIRECT_CODES[a]), generator=g)] for a in L.AXES}
+
+
+@unittest.skipUnless(HAVE_TORCH, "model stack not installed")
+class FocalLoss(unittest.TestCase):
+    def setUp(self):
+        self.targets = L.encode_targets(TT.labels())
+
+    def test_a_tiny_gamma_reduces_to_the_c1_loss(self):
+        z = logits_for(1)
+        for weights in (None, weights_for(2)):
+            plain, plain_parts = M.example_loss(z, self.targets, weights)
+            focal, focal_parts = M.example_loss(z, self.targets, weights, 1e-12)
+            self.assertAlmostEqual(focal.item(), plain.item(), places=5)
+            for a in L.AXES:
+                self.assertAlmostEqual(focal_parts[a].item(), plain_parts[a].item(), places=5, msg=a)
+
+    def test_gamma_two_matches_a_hand_computation(self):
+        z, w, gamma = logits_for(3), weights_for(4), 2.0
+        _, parts = M.example_loss(z, self.targets, w, gamma)
+        for a in L.AXES:
+            t, zz = self.targets[a], [float(x) for x in z[a]]
+            if a in L.SINGLE:
+                i, top = t["index"], max(zz)
+                p = math.exp(zz[i] - top) / sum(math.exp(x - top) for x in zz)
+                expected = w[a][i] * (1 - p) ** gamma * -math.log(p)
+            else:
+                terms = []
+                for c, (x, y) in enumerate(zip(zz, t["multi_hot"])):
+                    p = 1 / (1 + math.exp(-x))
+                    terms.append(-(w[a][c] * y * (1 - p) ** gamma * math.log(p) + (1 - y) * p ** gamma * math.log(1 - p)))
+                expected = sum(terms) / len(terms)
+            self.assertAlmostEqual(parts[a].item(), expected, places=5, msg=a)
+
+    def test_a_null_label_still_contributes_nothing(self):
+        targets = L.encode_targets(TT.labels(**{AIDEL: None}))
+        total, parts = M.example_loss(logits_for(5), targets, weights_for(6), 2.0)
+        self.assertIsNone(parts[AIDEL])
+        self.assertAlmostEqual(total.item(), sum(v.item() for v in parts.values() if v is not None), places=5)
+
+    def test_the_config_names_the_focal_loss_only_with_a_positive_gamma(self):
+        cfg = TT.tiny_config()
+        TM.check_config(cfg)                                   # C1's names, no gamma
+        focal = copy.deepcopy(cfg)
+        focal["loss"].update(FOCAL_NAMES, focal_gamma=2.0)
+        TM.check_config(focal)
+        bad = []
+        for change in ({"single_select": "cross_entropy"}, {"multi_select": "bce_with_logits_mean_over_codes"},
+                       {"focal_gamma": 0}, {"focal_gamma": -1.0}, {"focal_gamma": "2"}, {"focal_gamma": float("nan")}):
+            c = copy.deepcopy(focal)
+            c["loss"].update(change)
+            bad.append(c)
+        no_gamma = copy.deepcopy(focal)
+        del no_gamma["loss"]["focal_gamma"]
+        plain_with_gamma = copy.deepcopy(cfg)
+        plain_with_gamma["loss"]["focal_gamma"] = 2.0
+        for c in bad + [no_gamma, plain_with_gamma]:
+            with self.assertRaises(ValueError, msg=json.dumps(c["loss"], default=str)):
+                TM.check_config(c)
+
+    def test_a_focal_run_trains_on_cpu_and_starts_below_the_plain_run(self):
+        examples = TM.synthetic_examples(seed=3, sizes=(5, 3, 2, 2, 1, 1, 1, 1))
+        with tempfile.TemporaryDirectory() as tmp:
+            d = Path(tmp)
+            prepared, split = TM.write_synthetic_inputs(d / "inputs", examples, 11, 3, 4)
+            data = TM.load_data(prepared, split)
+            cfg = TT.tiny_config()
+            cfg["schedule"]["epochs"] = 1
+            cfg["loss"]["class_weights"] = TM.CLASS_WEIGHT_SCHEME
+            focal = copy.deepcopy(cfg)
+            focal["loss"].update(FOCAL_NAMES, focal_gamma=2.0)
+            losses = {}
+            for name, c in (("plain", cfg), ("focal", focal)):
+                out = TM.run_training(d / name, c, data, TT.IDENTITY, TT.tiny_backbone, TT.encode, torch.device("cpu"),
+                                      synthetic=True, command=["unittest"])
+                self.assertEqual(out["outcome"], "complete")
+                progress = json.loads((TM.checkpoint_path(d / name, "final") / "progress.json").read_text())
+                losses[name] = [s["loss_mean"] for s in progress["steps"]]
+            self.assertTrue(all(math.isfinite(x) for x in losses["focal"]))
+            # same seed, initial weights, class weights and data order: every focal factor is below 1
+            self.assertLess(losses["focal"][0], losses["plain"][0])
+
+
+@unittest.skipUnless(HAVE_TORCH, "model stack not installed")
+class SixContextTurns(unittest.TestCase):
+    def test_the_input_reads_up_to_six_earlier_interactions(self):
+        ex = TT.example(seg=8, context=[(f"earlier prompt {i}", f"earlier response {i}") for i in range(7)])
+        for n in (3, 6):
+            policy = MI.InputPolicy(max_tokens=3000, context_interactions=n, prompt_cap=160, response_cap=200,
+                                    min_context_fragment=64)
+            self.assertEqual(MI.build_input(ex, TT.encode, policy)["report"]["context_included"], n)
+
+    def test_the_v2_budget_passes_the_trainer_checks_and_adds_to_the_student_side_only(self):
+        cfg = TT.tiny_config()
+        cfg["input"].update(context_interactions=6, max_tokens=10240, prompt_cap=1536, response_cap=3072)
+        TM.check_config(cfg)
+        c1 = dict(cfg["input"], context_interactions=3, max_tokens=7168)
+        budget = {k: MI.InputPolicy.from_config(v).check_with(TT.encode)["student_side_budget"]
+                  for k, v in (("v2", cfg["input"]), ("c1", c1))}
+        self.assertEqual(budget["v2"] - budget["c1"], 10240 - 7168)     # the response reservation is unchanged
+
+
+if __name__ == "__main__":
+    unittest.main()
