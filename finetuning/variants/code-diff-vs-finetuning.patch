+#!/usr/bin/env python3
+"""Tokenizer-only input check for the D-194 variant configs (CPU), run with this folder's modules (the variant copy).
+
+    python variant_inputs.py <out.json> <name>=<config.json> [<name>=<config.json> ...]
+
+For each config: train_multihead.check_config, the prepared data and split it names (load_data, which applies the
+trainer's split checks), the prepared context window against the policy, and the built inputs (build_inputs). Writes
+per interaction only counts (tokens, what is cut, how many earlier interactions are included) and the inputs' SHA-256;
+no token ids and no text.
+"""
+import json
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import model_inputs as MI  # noqa: E402
+import train_multihead as T  # noqa: E402
+
+
+def main(argv) -> int:
+    out_path, result, encode = Path(argv[0]), {}, None
+    for arg in argv[1:]:
+        name, path = arg.split("=", 1)
+        cfg = json.loads(Path(path).read_text(encoding="utf-8"))
+        T.check_config(cfg)
+        if encode is None:
+            encode = T.tokenizer_encoder(T.model_snapshot(cfg["model"])[0])
+        policy = MI.InputPolicy.from_config(cfg["input"])
+        data = T.load_data(T.ROOT / cfg["data"]["prepared_dir"], T.ROOT / cfg["data"]["split_file"])
+        if data.fingerprint["split"]["validation_purpose"] != cfg["validation"]["purpose"]:      # as run_training requires
+            raise ValueError(f"{name}: the split records a different validation purpose from the config's")
+        window = data.fingerprint["prepared"].get("context_interactions")
+        if window is None or window < policy.context_interactions:
+            raise ValueError(f"{name}: prepared context window {window} < policy {policy.context_interactions}")
+        built, inputs_sha = T.build_inputs(data, encode, policy)
+        result[name] = {
+            "config": path, "inputs_sha256": inputs_sha, "prepared_context_window": window,
+            "student_side_budget": policy.check_with(encode)["student_side_budget"],
+            "parts": {p: len(data.keys(p)) for p in ("train", "validation")},
+            "per_interaction": {T.key_text(k): {"part": data.part_of[k], "tokens": b["report"]["tokens"],
+                                                "student_pool": b["student_pool"],
+                                                "prompt_tokens_omitted": b["report"]["prompt_tokens_omitted"],
+                                                "response_tokens_omitted": b["report"]["response_tokens_omitted"],
+                                                "context_tokens_omitted": b["report"]["context_tokens_omitted"],
+                                                "context_prepared": b["report"]["context_prepared"],
+                                                "context_included": b["report"]["context_included"]}
+                                for k, b in sorted(built.items())},
+            "code_sha256": {p: T.L.sha256_file(T.ROOT / p) for p in T.TRAINING_CODE}}
+    out_path.write_text(json.dumps(result, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")
+    print(json.dumps({n: {"interactions": len(r["per_interaction"]), "parts": r["parts"], "window": r["prepared_context_window"],
+                          "student_side_budget": r["student_side_budget"]} for n, r in result.items()}))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
